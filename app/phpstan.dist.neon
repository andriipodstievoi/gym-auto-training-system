includes:
    - vendor/phpstan/phpstan-symfony/extension.neon
    - vendor/phpstan/phpstan-symfony/rules.neon
    - vendor/phpstan/phpstan-doctrine/extension.neon
    - vendor/phpstan/phpstan-doctrine/rules.neon

parameters:
    level: 8
    paths:
        - src
        - tests
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml

    ignoreErrors:
        # The owning side of these associations is NOT NULL in the database, which
        # is correct: a floor zone always belongs to a branch and a piece of
        # equipment always sits in a zone. The PHP property stays nullable purely
        # so the bidirectional remove helpers can detach before orphan removal.
        -
            identifier: doctrine.associationType
            path: src/Entity/FloorZone.php
        -
            identifier: doctrine.associationType
            path: src/Entity/Equipment.php
