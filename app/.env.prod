# Committed defaults for APP_ENV=prod. Real environment variables win over
# this file, so anything set in infra/deploy/.env.prod overrides it.
#
# Loaded after .env and .env.local, before .env.prod.local.

###> symfony/mailer ###
# No mail provider configured is a supported state. The value in .env points
# at Mailpit on 127.0.0.1, which does not exist on a production host, so
# without this line every booking confirmation and password reset would raise
# a connection error instead of quietly going nowhere. Set a real DSN in
# infra/deploy/.env.prod when there is a relay to send through.
MAILER_DSN=null://null
###< symfony/mailer ###
