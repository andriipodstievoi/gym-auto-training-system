{% extends 'base.html.twig' %}

{% block body %}
    <section class="mx-auto max-w-6xl px-4 pt-20 pb-16">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-signal-500">{{ 'home.hero.kicker'|trans }}</p>
        <h1 class="mt-4 max-w-3xl text-5xl font-black leading-[1.05] text-white sm:text-6xl">
            {{ 'home.hero.title'|trans }}
        </h1>
        <p class="mt-6 max-w-2xl text-lg text-iron-200">{{ 'home.hero.lead'|trans }}</p>

        <div class="mt-9 flex flex-wrap gap-3">
            <a href="{{ path('assessment_start') }}" class="rounded-md bg-signal-500 px-6 py-3 font-semibold text-iron-900 transition hover:bg-signal-400">{{ 'home.hero.cta'|trans }}</a>
            <a href="{{ path('membership_index') }}" class="rounded-md border border-iron-600 px-6 py-3 font-semibold text-iron-200 transition hover:border-signal-600 hover:text-white">{{ 'home.hero.secondary'|trans }}</a>
            <a href="{{ path('branch_index') }}" class="rounded-md border border-iron-600 px-6 py-3 font-semibold text-iron-200 transition hover:border-signal-600 hover:text-white">{{ 'home.hero.branches'|trans }}</a>
        </div>
    </section>

    <section class="mx-auto max-w-6xl px-4 py-10">
        <h2 class="text-2xl font-bold text-white">{{ 'home.features.title'|trans }}</h2>

        <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {#
               The illustration repeats what the heading already says, so it is
               decorative and stays out of the accessible name - see the note in
               _illustration.html.twig.
            #}
            {% set feature_art = { map: 'map', memberships: 'membership', trainers: 'trainer', shop: 'shop', plan: 'plan' } %}
            {% for key in ['map', 'memberships', 'trainers', 'shop', 'plan'] %}
                <article class="rounded-xl border border-iron-800 bg-iron-800/40 p-6 transition hover:border-signal-600">
                    <span class="mb-4 inline-flex rounded-lg bg-iron-900/60 p-3 text-signal-500">
                        {% include 'partials/_illustration.html.twig' with { name: feature_art[key], class: 'size-8' } %}
                    </span>
                    <h3 class="text-lg font-bold text-white">{{ ('home.features.' ~ key ~ '.title')|trans }}</h3>
                    <p class="mt-2 text-sm leading-relaxed text-iron-200">{{ ('home.features.' ~ key ~ '.text')|trans }}</p>
                </article>
            {% endfor %}
        </div>
    </section>

    {# Milestone tracker - an Alpine-driven accordion, and proof the JS chain works. #}
    <section class="mx-auto max-w-6xl px-4 py-10" x-data="{ open: 'M0' }">
        <h2 class="text-2xl font-bold text-white">{{ 'home.status.title'|trans }}</h2>
        <p class="mt-2 text-sm text-iron-400">{{ 'home.status.lead'|trans }}</p>

        <ul class="mt-6 divide-y divide-iron-800 rounded-xl border border-iron-800">
            {% for m in milestones %}
                <li>
                    <button type="button" @click="open = (open === '{{ m.id }}' ? null : '{{ m.id }}')"
                            class="flex w-full items-center gap-4 px-5 py-4 text-left hover:bg-iron-800/40">
                        <span class="w-10 font-mono text-sm font-bold {{ m.done ? 'text-signal-500' : 'text-iron-400' }}">{{ m.id }}</span>
                        <span class="flex-1 font-medium text-iron-100">{{ m.title }}</span>
                        <span class="rounded px-2 py-1 text-xs font-semibold uppercase {{ m.done ? 'bg-signal-500 text-iron-900' : 'bg-iron-800 text-iron-400' }}">
                            {{ m.done ? 'done' : 'planned' }}
                        </span>
                    </button>
                    <div x-show="open === '{{ m.id }}'" x-cloak class="px-5 pb-4 pl-19 text-sm text-iron-400">
                        {{ m.detail }}
                    </div>
                </li>
            {% endfor %}
        </ul>
    </section>
{% endblock %}
