{% set current_route = app.request.attributes.get('_route') %}
{% set tabs = [
    { route: 'coach_dashboard', key: 'coach.nav.dashboard' },
    { route: 'coach_availability', key: 'coach.nav.availability' },
] %}

<nav aria-label="{{ 'coach.nav.label'|trans }}" class="mt-6 flex gap-1 border-b border-iron-800">
    {% for tab in tabs %}
        {% set active = current_route == tab.route %}
        <a href="{{ path(tab.route) }}"
           class="-mb-px border-b-2 px-4 py-2.5 text-sm font-medium {{ active ? 'border-signal-500 text-signal-500' : 'border-transparent text-iron-400 hover:text-white' }}"
           {{ active ? 'aria-current="page"' : '' }}>
            {{ tab.key|trans }}
        </a>
    {% endfor %}
</nav>
