{% extends 'base.html.twig' %}

{% block title %}{{ 'coach.availability.title'|trans }} · {{ 'brand.name'|trans }}{% endblock %}
{% block description %}{{ 'coach.availability.lead'|trans }}{% endblock %}

{% block body %}
    <section class="mx-auto max-w-4xl px-4 py-14">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-signal-500">{{ 'coach.kicker'|trans }}</p>
        <h1 class="mt-3 text-4xl font-black text-white">{{ 'coach.availability.title'|trans }}</h1>

        {% include 'coach/_nav.html.twig' %}

        <div class="mt-8">
            {% include 'partials/_flashes.html.twig' %}
        </div>

        <p class="text-iron-200">{{ 'coach.availability.lead'|trans }}</p>

        {% if windows|length > 0 %}
            <ul class="mt-6 divide-y divide-iron-800 rounded-xl border border-iron-800">
                {% for window in windows %}
                    <li class="flex flex-wrap items-center justify-between gap-4 px-5 py-4">
                        <p class="text-iron-100">
                            <span class="font-semibold text-white">{{ ('weekday.' ~ window.weekday)|trans }}</span>
                            <span class="ml-3 text-iron-400">{{ 'coach.availability.from'|trans }}</span>
                            {{ window.startTime|date('H:i') }}
                            <span class="ml-2 text-iron-400">{{ 'coach.availability.to'|trans }}</span>
                            {{ window.endTime|date('H:i') }}
                        </p>

                        <form method="post" action="{{ path('coach_availability_remove', {id: window.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('booking') }}">
                            <button type="submit"
                                    aria-label="{{ 'coach.availability.remove'|trans }}: {{ ('weekday.' ~ window.weekday)|trans }} {{ window.startTime|date('H:i') }}–{{ window.endTime|date('H:i') }}"
                                    title="{{ 'coach.availability.remove'|trans }}"
                                    class="inline-flex items-center rounded-lg border border-iron-700 p-2 text-iron-100 hover:border-signal-500 hover:text-signal-500">
                                {% include 'partials/_icon.html.twig' with { name: 'trash' } %}
                            </button>
                        </form>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="mt-6 rounded-xl border border-iron-800 bg-iron-800/40 px-6 py-5 text-iron-200">
                {{ 'coach.availability.empty'|trans }}
            </p>
        {% endif %}

        <h2 class="mt-10 text-lg font-bold text-white">{{ 'coach.availability.add'|trans }}</h2>

        {{ form_start(form, {attr: {class: 'mt-4 space-y-5 rounded-xl border border-iron-800 bg-iron-800/40 p-6'}}) }}
            {{ form_row(form.weekday) }}
            {{ form_row(form.startTime) }}
            {{ form_row(form.endTime) }}

            <button type="submit" class="rounded-lg bg-signal-500 px-6 py-3 font-semibold text-iron-900 hover:bg-signal-400">
                {{ 'coach.availability.add'|trans }}
            </button>
        {{ form_end(form) }}
    </section>
{% endblock %}
