{# One catalogue tile. The whole card is not a link: the accessible name of a
   link must match what it visibly says, and a tile carries a price too. #}
{% set locale = app.request.locale %}
{% set in_stock = product.totalStock > 0 %}

{#
   Keyed off the category rather than the product, so a new product in a known
   section gets the right drawing without anybody editing a map. An unknown
   section falls back to the barbell rather than to a hole.
#}
{% set art = {
    'protein': 'protein',
    'creatine': 'creatine',
    'apparel': 'apparel',
    'accessories': 'accessory',
} %}
{% set art_name = product.category ? (art[product.category.slug]|default('barbell')) : 'barbell' %}

<article class="flex flex-col rounded-xl border border-iron-800 bg-iron-800/40 p-6 transition hover:border-signal-600">
    <span class="mb-4 inline-flex self-start rounded-lg bg-iron-900/60 p-3 text-signal-500">
        {% include 'partials/_illustration.html.twig' with { name: art_name, class: 'size-9' } %}
    </span>

    <h3 class="text-lg font-bold text-white">{{ product.name.get(locale) }}</h3>

    {% if product.description and not product.description.isEmpty %}
        <p class="mt-3 text-sm leading-relaxed text-iron-200">{{ product.description.get(locale) }}</p>
    {% endif %}

    <p class="mt-4 flex items-baseline gap-2">
        {% if product.hasVariants %}
            <span class="text-sm text-iron-400">{{ 'shop.product.from_price'|trans }}</span>
        {% endif %}
        <span class="text-2xl font-black text-white">{{ (product.priceCentsFrom / 100)|format_currency('EUR') }}</span>
    </p>

    <p class="mt-2 text-xs font-semibold uppercase tracking-wide {{ in_stock ? 'text-signal-500' : 'text-iron-400' }}">
        {{ in_stock ? 'shop.product.in_stock'|trans : 'shop.product.out_of_stock'|trans }}
    </p>

    <a href="{{ path('shop_product', {slug: product.slug}) }}"
       class="mt-auto pt-5 text-sm font-semibold text-signal-500 hover:text-signal-400">
        {{ product.name.get(locale) }} &rarr;
    </a>
</article>
