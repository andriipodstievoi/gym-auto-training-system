{% extends 'base.html.twig' %}

{% set locale = app.request.locale %}

{% block title %}{{ category.name.get(locale) }} · {{ 'brand.name'|trans }}{% endblock %}
{% block description %}{{ 'shop.index.lead'|trans }}{% endblock %}

{% block body %}
    <section class="mx-auto max-w-6xl px-4 pt-14 pb-8">
        <a href="{{ path('shop_index') }}" class="text-sm font-semibold text-signal-500 hover:text-signal-400">
            &larr; {{ 'shop.category.back'|trans }}
        </a>
        <h1 class="mt-3 text-4xl font-black leading-tight text-white sm:text-5xl">{{ category.name.get(locale) }}</h1>
    </section>

    <section class="mx-auto max-w-6xl px-4 pb-16">
        {% include 'partials/_flashes.html.twig' %}

        {% if products|length > 0 %}
            <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
                {% for product in products %}
                    {% include 'shop/_card.html.twig' with {product: product} only %}
                {% endfor %}
            </div>
        {% else %}
            <p class="rounded-xl border border-iron-800 bg-iron-800/40 px-6 py-4 text-sm text-iron-400">
                {{ 'shop.category.empty'|trans }}
            </p>
        {% endif %}
    </section>
{% endblock %}
