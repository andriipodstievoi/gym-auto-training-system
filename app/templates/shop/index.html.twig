{% extends 'base.html.twig' %}

{% set locale = app.request.locale %}

{% block title %}{{ 'shop.index.title'|trans }} · {{ 'brand.name'|trans }}{% endblock %}
{% block description %}{{ 'shop.index.lead'|trans }}{% endblock %}

{% block body %}
    <section class="mx-auto max-w-6xl px-4 pt-14 pb-8">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-signal-500">{{ 'shop.index.kicker'|trans }}</p>
        <h1 class="mt-3 text-4xl font-black leading-tight text-white sm:text-5xl">{{ 'shop.index.title'|trans }}</h1>
        <p class="mt-4 max-w-2xl text-lg text-iron-200">{{ 'shop.index.lead'|trans }}</p>
    </section>

    <section class="mx-auto max-w-6xl px-4 pb-16">
        {% include 'partials/_flashes.html.twig' %}

        {% for section in sections %}
            <div class="{{ loop.first ? '' : 'mt-14' }}">
                <div class="flex flex-wrap items-baseline justify-between gap-3">
                    <h2 class="text-2xl font-bold text-white">{{ section.category.name.get(locale) }}</h2>
                    <a href="{{ path('shop_category', {slug: section.category.slug}) }}"
                       class="text-sm font-semibold text-signal-500 hover:text-signal-400">
                        {{ section.category.name.get(locale) }} &rarr;
                    </a>
                </div>

                <div class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
                    {% for product in section.products %}
                        {% include 'shop/_card.html.twig' with {product: product} only %}
                    {% endfor %}
                </div>
            </div>
        {% endfor %}
    </section>
{% endblock %}
