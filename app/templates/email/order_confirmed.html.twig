{% extends 'email/_layout.html.twig' %}

{% block subject %}{{ 'email.order.subject'|trans({}, 'messages', locale) }}{% endblock %}

{% block content %}
    <p style="margin:0 0 16px;font-size:20px;font-weight:bold;color:#ffffff;">
        {{ 'email.order.heading'|trans({'%reference%': order.reference}, 'messages', locale) }}
    </p>

    <p style="margin:0 0 20px;">
        {{ 'email.order.body'|trans({}, 'messages', locale) }}
    </p>

    {#
       The lines are read from the order's own snapshots, never through the
       product: by the time somebody opens this mail the catalogue may have
       been repriced, and the receipt has to keep saying what was charged.
    #}
    <table role="presentation" cellpadding="0" cellspacing="0" style="width:100%;font-size:14px;">
        {% for item in order.items %}
            <tr>
                <td style="padding:6px 0;color:#a1a1aa;">
                    {{ item.nameSnapshot.get(locale) }}
                    <span style="color:#71717a;">&times;{{ item.quantity }}</span>
                </td>
                <td style="padding:6px 0;text-align:right;color:#ffffff;">
                    {{ (item.lineTotalCents / 100)|format_currency('EUR', locale=locale) }}
                </td>
            </tr>
        {% endfor %}
        <tr>
            <td style="padding:12px 0 6px;border-top:1px solid #3f3f46;color:#a1a1aa;">
                {{ 'shop.order.total'|trans({}, 'messages', locale) }}
            </td>
            <td style="padding:12px 0 6px;border-top:1px solid #3f3f46;text-align:right;color:#ffffff;font-weight:bold;">
                {{ (order.totalCents / 100)|format_currency('EUR', locale=locale) }}
            </td>
        </tr>
    </table>

    <p style="margin:24px 0 0;">
        <a href="{{ url('app_account_orders', {'_locale': locale}) }}"
           style="display:inline-block;background:#84cc16;color:#18181b;text-decoration:none;font-weight:bold;padding:12px 24px;border-radius:8px;">
            {{ 'email.order.cta'|trans({}, 'messages', locale) }}
        </a>
    </p>
{% endblock %}
