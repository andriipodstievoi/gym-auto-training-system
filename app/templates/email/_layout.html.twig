{#
   Shared shell for member mail.

   Every string is translated with an explicit locale rather than the ambient
   one: the webhook that triggers the membership mail arrives from Stripe with
   no locale at all, so the member's own setting is the only thing to trust.
#}
<!DOCTYPE html>
<html lang="{{ locale }}">
    <head>
        <meta charset="UTF-8">
        <title>{% block subject %}{% endblock %}</title>
    </head>
    <body style="margin:0;padding:24px;background:#18181b;color:#e4e4e7;font-family:Arial,Helvetica,sans-serif;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;margin:0 auto;">
            <tr>
                <td style="padding-bottom:24px;font-size:24px;font-weight:bold;color:#ffffff;">
                    {{ 'brand.name'|trans({}, 'messages', locale) }}<span style="color:#84cc16;">.</span>
                </td>
            </tr>
            <tr>
                <td style="background:#27272a;border-radius:12px;padding:28px;line-height:1.6;">
                    {% block content %}{% endblock %}
                </td>
            </tr>
            <tr>
                <td style="padding-top:24px;font-size:12px;color:#a1a1aa;">
                    {{ 'footer.address'|trans({}, 'messages', locale) }} ·
                    {{ 'footer.disclaimer'|trans({}, 'messages', locale) }}
                </td>
            </tr>
        </table>
    </body>
</html>
