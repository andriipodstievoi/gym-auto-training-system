{% extends 'base.html.twig' %}

{% set locale = app.request.locale %}

{% block title %}{{ 'branch.index.title'|trans }} · {{ 'brand.name'|trans }}{% endblock %}
{% block description %}{{ 'branch.index.lead'|trans }}{% endblock %}

{# Leaflet is heavy, so it loads on this page only. #}
{% block importmap %}{{ importmap(['app', 'map']) }}{% endblock %}

{% block body %}
    <section class="mx-auto max-w-6xl px-4 pt-14 pb-8">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-signal-500">{{ 'branch.index.kicker'|trans }}</p>
        <h1 class="mt-3 text-4xl font-black leading-tight text-white sm:text-5xl">{{ 'branch.index.title'|trans }}</h1>
        <p class="mt-4 max-w-2xl text-lg text-iron-200">{{ 'branch.index.lead'|trans }}</p>
    </section>

    <section class="mx-auto max-w-6xl px-4">
        <div data-controller="branch-map"
             class="h-[420px] w-full overflow-hidden rounded-xl border border-iron-800 bg-iron-800 sm:h-[520px]"
             aria-label="{{ 'branch.index.heading'|trans }}"
             data-branches="{{ map_markers|json_encode }}"
             data-labels="{{ {
                 openNow: 'branch.map.open_now'|trans,
                 closedNow: 'branch.map.closed_now'|trans,
                 today: 'branch.map.today'|trans,
                 closedToday: 'branch.map.closed_today'|trans,
                 view: 'branch.map.view'|trans
             }|json_encode }}"></div>
        <p class="mt-3 text-sm text-iron-400">{{ 'branch.map.hint'|trans }}</p>
    </section>

    <section class="mx-auto max-w-6xl px-4 py-12">
        <h2 class="text-2xl font-bold text-white">{{ 'branch.index.heading'|trans }}</h2>

        <div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
            {% for branch in branches %}
                {% set schedule = schedules[branch.slug] %}
                {% set period = schedule.forDay(today) %}

                <article class="flex flex-col rounded-xl border border-iron-800 bg-iron-800/40 p-6 transition hover:border-signal-600">
                    <div class="flex items-start justify-between gap-3">
                        <h3 class="text-xl font-bold text-white">{{ branch.name }}</h3>
                        {% if schedule.isOpenAt(now) %}
                            <span class="shrink-0 rounded-full bg-signal-500 px-2.5 py-1 text-xs font-bold uppercase tracking-wide text-iron-900">{{ 'branch.map.open_now'|trans }}</span>
                        {% else %}
                            <span class="shrink-0 rounded-full border border-iron-600 px-2.5 py-1 text-xs font-bold uppercase tracking-wide text-iron-400">{{ 'branch.show.closed'|trans }}</span>
                        {% endif %}
                    </div>

                    <p class="mt-3 text-sm text-iron-200">{{ branch.addressLine }}, {{ branch.city }} {{ branch.postalCode }}</p>
                    <p class="mt-1 text-sm text-iron-400">
                        {{ 'branch.map.today'|trans }}:
                        {%- if period %} {{ period.open }}&ndash;{{ period.close }}{% else %} {{ 'branch.map.closed_today'|trans }}{% endif %}
                    </p>

                    {% if branch.floorZones|length %}
                        <ul class="mt-4 flex flex-wrap gap-1.5">
                            {% for zone in branch.floorZones %}
                                <li class="rounded bg-iron-800 px-2 py-1 text-xs text-iron-200">{{ zone.name.get(locale) }}</li>
                            {% endfor %}
                        </ul>
                    {% endif %}

                    <a href="{{ path('branch_show', {slug: branch.slug}) }}"
                       class="mt-auto pt-5 text-sm font-semibold text-signal-500 hover:text-signal-400">
                        {{ 'branch.card.view'|trans }} &rarr;
                    </a>
                </article>
            {% endfor %}
        </div>
    </section>
{% endblock %}
