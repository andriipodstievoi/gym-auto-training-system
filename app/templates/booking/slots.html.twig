{% extends 'base.html.twig' %}

{% set tz = gym_timezone() %}

{% block title %}{{ 'booking.title'|trans({'%coach%': trainer.fullName}) }} · {{ 'brand.name'|trans }}{% endblock %}
{% block description %}{{ 'booking.lead'|trans }}{% endblock %}

{% block body %}
    <section class="mx-auto max-w-3xl px-4 pt-10 pb-16">
        <a href="{{ path('trainer_show', {slug: trainer.slug}) }}" class="text-sm font-medium text-iron-400 hover:text-signal-500">
            &larr; {{ trainer.fullName }}
        </a>

        <p class="mt-6 text-sm font-semibold uppercase tracking-[0.2em] text-signal-500">{{ 'booking.kicker'|trans }}</p>
        <h1 class="mt-3 text-4xl font-black leading-tight text-white sm:text-5xl">
            {{ 'booking.title'|trans({'%coach%': trainer.fullName}) }}
        </h1>
        <p class="mt-4 text-lg text-iron-200">{{ 'booking.lead'|trans }}</p>

        <p class="mt-3 text-sm text-iron-400">
            {{ 'trainer.rate'|trans({'%amount%': (trainer.hourlyRateCents / 100)|format_currency('EUR')}) }}
        </p>

        <div class="mt-8">
            {% include 'partials/_flashes.html.twig' %}
        </div>

        {% if days|length == 0 %}
            <p class="mt-6 rounded-xl border border-iron-800 bg-iron-800/40 px-6 py-5 text-iron-200">
                {{ trainer.hasActiveAvailability ? 'booking.slots.none'|trans : 'trainer.no_availability'|trans }}
            </p>
        {% elseif app.user %}
            <form method="post" action="{{ path('booking_create', {slug: trainer.slug}) }}" class="mt-8">
                <input type="hidden" name="_token" value="{{ csrf_token('booking') }}">

                <fieldset>
                    <legend class="text-lg font-bold text-white">{{ 'booking.slots.pick'|trans }}</legend>

                    <div class="mt-5 space-y-6">
                        {% for day in days %}
                            <div>
                                <h2 class="text-sm font-semibold uppercase tracking-wide text-iron-400">
                                    {{ ('weekday.' ~ day.weekday)|trans }} ·
                                    {{ day.date|format_date('medium', timezone=tz) }}
                                </h2>

                                <div class="mt-3 flex flex-wrap gap-2">
                                    {% for slot in day.slots %}
                                        {% set slot_id = 'slot-' ~ loop.parent.loop.index ~ '-' ~ loop.index %}
                                        <div>
                                            <input type="radio" class="peer sr-only" name="slot"
                                                   id="{{ slot_id }}" value="{{ slot.key }}"
                                                   {{ loop.parent.loop.first and loop.first ? 'checked' : '' }}>
                                            <label for="{{ slot_id }}"
                                                   class="cursor-pointer rounded-lg border border-iron-700 px-4 py-2 text-sm text-iron-100 hover:border-signal-500 peer-checked:border-signal-500 peer-checked:bg-signal-500 peer-checked:text-iron-900 peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-signal-400">
                                                {{ slot.startsAt|format_time('short', timezone=tz) }}
                                            </label>
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </fieldset>

                <div class="mt-8">
                    <label for="booking-notes" class="block text-sm font-semibold text-white">
                        {{ 'booking.form.notes'|trans }}
                    </label>
                    <p id="booking-notes-help" class="mt-1 text-sm text-iron-400">{{ 'booking.form.notes_help'|trans }}</p>
                    <textarea id="booking-notes" name="notes" rows="4" maxlength="2000"
                              aria-describedby="booking-notes-help"
                              class="mt-2 w-full rounded-lg border border-iron-700 bg-iron-900 px-4 py-3 text-iron-100 focus:border-signal-500 focus:outline-none"></textarea>
                </div>

                <dl class="mt-6 flex flex-wrap gap-x-8 gap-y-2 text-sm text-iron-200">
                    <div>
                        <dt class="inline text-iron-400">{{ 'booking.form.duration'|trans }}:</dt>
                        <dd class="inline font-semibold">60 min</dd>
                    </div>
                    <div>
                        <dt class="inline text-iron-400">{{ 'booking.form.price'|trans }}:</dt>
                        <dd class="inline font-semibold">{{ (trainer.hourlyRateCents / 100)|format_currency('EUR') }}</dd>
                    </div>
                </dl>

                <button type="submit"
                        class="mt-6 rounded-lg bg-signal-500 px-6 py-3 font-semibold text-iron-900 hover:bg-signal-400">
                    {{ 'booking.form.submit'|trans }}
                </button>
            </form>
        {% else %}
            <h2 class="mt-8 text-lg font-bold text-white">{{ 'booking.slots.title'|trans }}</h2>

            <div class="mt-5 space-y-6">
                {% for day in days %}
                    <div>
                        <h3 class="text-sm font-semibold uppercase tracking-wide text-iron-400">
                            {{ ('weekday.' ~ day.weekday)|trans }} ·
                            {{ day.date|format_date('medium', timezone=tz) }}
                        </h3>
                        <ul class="mt-3 flex flex-wrap gap-2">
                            {% for slot in day.slots %}
                                <li class="rounded-lg border border-iron-700 px-4 py-2 text-sm text-iron-100">
                                    {{ slot.startsAt|format_time('short', timezone=tz) }}
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endfor %}
            </div>

            <a href="{{ path('app_login') }}"
               class="mt-8 inline-block rounded-lg bg-signal-500 px-6 py-3 font-semibold text-iron-900 hover:bg-signal-400">
                {{ 'trainer.sign_in_to_book'|trans }}
            </a>
        {% endif %}
    </section>
{% endblock %}
