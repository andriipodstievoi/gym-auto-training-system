{% extends 'base.html.twig' %}

{% set tz = gym_timezone() %}

{% block title %}{{ 'message.title'|trans }} · {{ 'brand.name'|trans }}{% endblock %}
{% block description %}{{ 'message.lead'|trans }}{% endblock %}

{% block body %}
    <section class="mx-auto max-w-3xl px-4 py-14">
        <h1 class="text-4xl font-black text-white">{{ 'message.title'|trans }}</h1>
        <p class="mt-4 text-lg text-iron-200">{{ 'message.lead'|trans }}</p>

        <div class="mt-8">
            {% include 'partials/_flashes.html.twig' %}
        </div>

        {% if conversations|length > 0 %}
            <ul class="mt-2 divide-y divide-iron-800 rounded-xl border border-iron-800">
                {% for conversation in conversations %}
                    {% set unread = conversation.unreadCountFor(app.user) %}
                    <li>
                        <a href="{{ path('message_thread', {id: conversation.id}) }}"
                           class="flex items-center justify-between gap-4 px-5 py-4 hover:bg-iron-800/40">
                            <span>
                                <span class="block font-semibold text-white">{{ conversation.counterpartNameFor(app.user) }}</span>
                                <span class="mt-1 block text-sm text-iron-400">
                                    {{ conversation.lastMessageAt|format_datetime('medium', 'short', timezone=tz) }}
                                </span>
                            </span>
                            {% if unread > 0 %}
                                <span class="shrink-0 rounded-full bg-signal-500 px-3 py-1 text-xs font-bold text-iron-900">
                                    {{ unread }} {{ 'message.unread'|trans }}
                                </span>
                            {% endif %}
                        </a>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <div class="mt-2 rounded-xl border border-iron-800 bg-iron-800/40 p-7">
                <p class="text-iron-200">{{ 'message.empty'|trans }}</p>
                <a href="{{ path('trainer_index') }}"
                   class="mt-5 inline-block rounded-lg bg-signal-500 px-5 py-2.5 font-semibold text-iron-900 hover:bg-signal-400">
                    {{ 'message.start'|trans }}
                </a>
            </div>
        {% endif %}
    </section>
{% endblock %}
