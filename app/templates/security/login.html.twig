{% extends 'base.html.twig' %}

{% block title %}{{ 'login.title'|trans }} · {{ 'brand.name'|trans }}{% endblock %}
{% block description %}{{ 'login.lead'|trans }}{% endblock %}

{% block body %}
    <section class="mx-auto max-w-md px-4 py-16">
        <h1 class="text-3xl font-black text-white">{{ 'login.title'|trans }}</h1>
        <p class="mt-3 text-sm text-iron-200">{{ 'login.lead'|trans }}</p>

        <div class="mt-8">
            {% include 'partials/_flashes.html.twig' %}

            {% if error %}
                <div role="alert" class="mb-4 rounded-lg border border-red-500/40 bg-red-500/10 px-4 py-3 text-sm text-red-300">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            <form method="post" class="space-y-5">
                <div>
                    <label for="username" class="block text-sm font-medium text-iron-200">{{ 'login.email'|trans }}</label>
                    <input type="email" id="username" name="_username" value="{{ last_username }}"
                           autocomplete="username" required autofocus
                           class="mt-1.5 w-full rounded-lg border border-iron-700 bg-iron-900 px-3 py-2 text-white outline-none focus:ring-2 focus:ring-signal-500">
                </div>

                <div>
                    <label for="password" class="block text-sm font-medium text-iron-200">{{ 'login.password'|trans }}</label>
                    <input type="password" id="password" name="_password" autocomplete="current-password" required
                           class="mt-1.5 w-full rounded-lg border border-iron-700 bg-iron-900 px-3 py-2 text-white outline-none focus:ring-2 focus:ring-signal-500">
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button type="submit"
                        class="w-full rounded-lg bg-signal-500 px-4 py-2.5 font-semibold text-iron-900 hover:bg-signal-400">
                    {{ 'login.submit'|trans }}
                </button>
            </form>

            <p class="mt-6 text-sm text-iron-400">
                {{ 'login.no_account'|trans }}
                <a href="{{ path('app_register') }}" class="font-semibold text-signal-500 hover:text-signal-400">{{ 'login.register_link'|trans }}</a>
            </p>
        </div>
    </section>
{% endblock %}
