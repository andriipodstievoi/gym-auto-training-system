{% extends 'base.html.twig' %}
{% import 'partials/_form_field.html.twig' as fields %}

{% block title %}{{ 'register.title'|trans }} · {{ 'brand.name'|trans }}{% endblock %}
{% block description %}{{ 'register.lead'|trans }}{% endblock %}

{% block body %}
    <section class="mx-auto max-w-md px-4 py-16">
        <h1 class="text-3xl font-black text-white">{{ 'register.title'|trans }}</h1>
        <p class="mt-3 text-sm text-iron-200">{{ 'register.lead'|trans }}</p>

        <div class="mt-8">
            {% include 'partials/_flashes.html.twig' %}

            {{ form_start(form, { attr: { class: 'space-y-5', novalidate: 'novalidate' } }) }}
                {% if not form.vars.valid %}
                    <div role="alert" class="rounded-lg border border-red-500/40 bg-red-500/10 px-4 py-3 text-sm text-red-300">
                        {{ 'register.error.summary'|trans }}
                    </div>
                {% endif %}

                <div class="grid gap-5 sm:grid-cols-2">
                    {{ fields.field(form.firstName) }}
                    {{ fields.field(form.lastName) }}
                </div>

                {{ fields.field(form.email) }}
                {{ fields.field(form.plainPassword.first) }}
                {{ fields.field(form.plainPassword.second) }}

                <button type="submit"
                        class="w-full rounded-lg bg-signal-500 px-4 py-2.5 font-semibold text-iron-900 hover:bg-signal-400">
                    {{ 'register.submit'|trans }}
                </button>
            {{ form_end(form) }}

            <p class="mt-6 text-sm text-iron-400">
                {{ 'register.have_account'|trans }}
                <a href="{{ path('app_login') }}" class="font-semibold text-signal-500 hover:text-signal-400">{{ 'register.login_link'|trans }}</a>
            </p>
        </div>
    </section>
{% endblock %}
