<!DOCTYPE html>
<html lang="{{ app.request.locale }}" class="h-full">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}{{ 'brand.name'|trans }}{% endblock %}</title>
        <meta name="description" content="{% block description %}{{ 'brand.tagline'|trans }}{% endblock %}">
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.05em%22 font-size=%22104%22>🏋️</text></svg>">

        {# Without Alpine there is nothing to reveal things later, so x-cloak
           must stop hiding them. The floor plan then shows every zone at once. #}
        <noscript><style>[x-cloak] { display: revert !important; }</style></noscript>

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="h-full bg-iron-900 text-iron-100 antialiased">
        {#
           The first thing a keyboard reaches on every page. Without it, getting
           to the content past a twelve-item header costs a dozen tab presses on
           every single navigation - which is most of what using this site by
           keyboard would be. It is off-screen until focused.
        #}
        <a href="#content"
           class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-signal-500 focus:px-4 focus:py-2 focus:font-semibold focus:text-iron-900">
            {{ 'a11y.skip_to_content'|trans }}
        </a>

        {% block header %}{% include 'partials/_header.html.twig' %}{% endblock %}

        {# tabindex="-1" so the skip link can actually move focus here. #}
        <main id="content" tabindex="-1">{% block body %}{% endblock %}</main>

        {% block footer %}{% include 'partials/_footer.html.twig' %}{% endblock %}
    </body>
</html>
