{#
   One interface icon, by name.

   Separate from _illustration.html.twig on purpose: illustrations decorate a
   card that already names itself, icons sit inside controls. That difference
   is an accessibility difference, not a stylistic one.

   **An icon is never an accessible name.** A button whose only content is one
   of these is a button screen readers announce as "button". Every caller must
   supply the name itself - either a visible label beside the icon, or
   sr-only text, or aria-label on the control. Lighthouse checks this, and it
   has caught a real defect in three milestones running.

   Right:
     <button aria-label="{{ 'shop.cart.remove'|trans }}">
         {% include 'partials/_icon.html.twig' with { name: 'trash' } %}
     </button>

   Also right, and better when there is room:
     <button>
         {% include 'partials/_icon.html.twig' with { name: 'trash' } %}
         <span>{{ 'shop.cart.remove'|trans }}</span>
     </button>

   Wrong:
     <button>{% include 'partials/_icon.html.twig' with { name: 'trash' } %}</button>
#}
{% set name = name|default('default') %}
{% set class = class|default('size-4') %}

<svg class="{{ class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
     aria-hidden="true" focusable="false">
    {% if name == 'cart' %}
        <circle cx="9" cy="20" r="1.5"/><circle cx="18" cy="20" r="1.5"/>
        <path d="M2 3h3l2.4 12.1a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 2-1.6L21 7H6"/>
    {% elseif name == 'plus' %}
        <path d="M12 5v14M5 12h14"/>
    {% elseif name == 'minus' %}
        <path d="M5 12h14"/>
    {% elseif name == 'trash' %}
        <path d="M3 6h18M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2"/>
        <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
        <path d="M10 11v6M14 11v6"/>
    {% elseif name == 'refresh' %}
        <path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 3v6h-6"/>
    {% elseif name == 'card' %}
        <rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/>
    {% elseif name == 'download' %}
        <path d="M12 3v12"/><path d="M7 11l5 5 5-5"/><path d="M4 20h16"/>
    {% elseif name == 'check' %}
        <path d="M4 12.5 9.5 18 20 6.5"/>
    {% elseif name == 'x' %}
        <path d="M6 6l12 12M18 6 6 18"/>
    {% elseif name == 'send' %}
        <path d="M21 3 10.5 13.5"/><path d="M21 3l-7 18-3.5-7.5L3 10l18-7Z"/>
    {% elseif name == 'calendar' %}
        <rect x="3" y="5" width="18" height="16" rx="2"/>
        <path d="M3 10h18M8 3v4M16 3v4"/>
    {% elseif name == 'message' %}
        <path d="M21 12a8 8 0 0 1-8 8H7l-4 3v-6a8 8 0 0 1 8-8h2a8 8 0 0 1 8 3Z"/>
    {% elseif name == 'arrow-left' %}
        <path d="M19 12H5"/><path d="M11 6l-6 6 6 6"/>
    {% elseif name == 'arrow-right' %}
        <path d="M5 12h14"/><path d="M13 6l6 6-6 6"/>
    {% elseif name == 'user' %}
        <circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>
    {% else %}
        <circle cx="12" cy="12" r="9"/>
    {% endif %}
</svg>
