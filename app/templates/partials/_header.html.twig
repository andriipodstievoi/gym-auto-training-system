{#
   Nav entries split in two: pages that exist, and pages a later milestone
   still owes. The pending ones stay visible so the shape of the site is
   honest rather than growing an item at a time.
#}
{% set links = [
    { key: 'map', route: 'branch_index', prefix: 'branch_' },
    { key: 'memberships', route: 'membership_index', prefix: 'membership_' },
    { key: 'trainers', route: 'trainer_index', prefix: 'trainer_' },
] %}
{% set pending = ['shop'] %}
{% set current = app.request.attributes.get('_route') %}

<header x-data="{ open: false }" class="sticky top-0 z-40 border-b border-iron-800 bg-iron-900/90 backdrop-blur">
    <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4">
        <a href="{{ path('home') }}" class="text-2xl font-black tracking-tight text-white">
            {{ 'brand.name'|trans }}<span class="text-signal-500">.</span>
        </a>

        <nav class="hidden items-center gap-7 text-sm font-medium md:flex">
            {% for link in links %}
                {% set active = current starts with link.prefix %}
                <a href="{{ path(link.route) }}"
                   class="{{ active ? 'text-signal-500' : 'text-iron-200 hover:text-white' }}"
                   {{ active ? 'aria-current="page"' : '' }}>
                    {{ ('nav.' ~ link.key)|trans }}
                </a>
            {% endfor %}
            {% for key in pending %}
                <span class="cursor-not-allowed text-iron-400" title="{{ 'nav.soon'|trans }}">{{ ('nav.' ~ key)|trans }}</span>
            {% endfor %}
            <span class="cursor-not-allowed rounded-md bg-signal-500 px-4 py-2 font-semibold text-iron-900" title="{{ 'nav.soon'|trans }}">{{ 'nav.quiz'|trans }}</span>
            {% include 'partials/_locale_switcher.html.twig' %}
        </nav>

        <button @click="open = !open" class="text-iron-200 md:hidden" aria-label="{{ 'nav.menu'|trans }}">
            <svg class="size-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path x-show="!open" stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16"/>
                <path x-show="open" x-cloak stroke-linecap="round" d="M6 18 18 6M6 6l12 12"/>
            </svg>
        </button>
    </div>

    <div x-show="open" x-cloak class="border-t border-iron-800 px-4 py-4 md:hidden">
        <div class="flex flex-col gap-3 text-sm">
            {% for link in links %}
                <a href="{{ path(link.route) }}" class="text-iron-100 hover:text-signal-500">{{ ('nav.' ~ link.key)|trans }}</a>
            {% endfor %}
            {% for key in pending|merge(['quiz']) %}
                <span class="text-iron-400">{{ ('nav.' ~ key)|trans }}</span>
            {% endfor %}
            {% include 'partials/_locale_switcher.html.twig' %}
        </div>
    </div>
</header>
