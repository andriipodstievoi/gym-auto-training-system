{% extends 'base.html.twig' %}

{% set programme = plan.programme %}

{% block title %}{{ 'plan.title'|trans }} · {{ 'brand.name'|trans }}{% endblock %}
{% block description %}{{ 'plan.lead'|trans({
    '%split%': plan.split,
    '%weeks%': plan.weekCount,
    '%days%': plan.daysPerWeek,
}) }}{% endblock %}

{% block body %}
    <section class="mx-auto max-w-4xl px-4 pt-10 pb-16">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-signal-500">{{ 'plan.kicker'|trans }}</p>
        <h1 class="mt-3 text-4xl font-black leading-tight text-white sm:text-5xl">{{ 'plan.title'|trans }}</h1>
        <p class="mt-4 text-lg text-iron-200">
            {{ 'plan.lead'|trans({
                '%split%': plan.split,
                '%weeks%': plan.weekCount,
                '%days%': plan.daysPerWeek,
            }) }}
        </p>

        <div class="mt-8">
            {% include 'partials/_flashes.html.twig' %}
        </div>

        <dl class="grid gap-4 rounded-xl border border-iron-800 bg-iron-800/40 p-6 sm:grid-cols-3">
            <div>
                <dt class="text-xs uppercase tracking-wide text-iron-400">{{ 'plan.split'|trans }}</dt>
                <dd class="mt-1 font-semibold text-white">{{ plan.split }}</dd>
            </div>
            <div>
                <dt class="text-xs uppercase tracking-wide text-iron-400">{{ 'plan.weeks'|trans }}</dt>
                <dd class="mt-1 font-semibold text-white">{{ plan.weekCount }}</dd>
            </div>
            <div>
                <dt class="text-xs uppercase tracking-wide text-iron-400">{{ 'plan.days_per_week'|trans }}</dt>
                <dd class="mt-1 font-semibold text-white">{{ plan.daysPerWeek }}</dd>
            </div>
            <div>
                <dt class="text-xs uppercase tracking-wide text-iron-400">{{ 'plan.generated_at'|trans }}</dt>
                <dd class="mt-1 text-iron-200">{{ plan.createdAt|format_datetime('medium', 'short', timezone=gym_timezone()) }}</dd>
            </div>
            <div>
                <dt class="text-xs uppercase tracking-wide text-iron-400">{{ 'plan.engine'|trans }}</dt>
                <dd class="mt-1 text-iron-200">{{ plan.engineVersion }}</dd>
            </div>
            <div>
                <dt class="text-xs uppercase tracking-wide text-iron-400">{{ 'account.plans.goal'|trans }}</dt>
                <dd class="mt-1 text-iron-200">{{ plan.assessment.goal.translationKey|trans }}</dd>
            </div>
        </dl>

        <div class="mt-6 flex flex-wrap gap-3">
            <a href="{{ path('plan_pdf', {id: plan.id}) }}"
               class="inline-flex items-center gap-2 rounded-lg bg-signal-500 px-5 py-2.5 font-semibold text-iron-900 hover:bg-signal-400">
                {% include 'partials/_icon.html.twig' with { name: 'download', class: 'size-5' } %}
                {{ 'plan.download_pdf'|trans }}
            </a>
            <a href="{{ path('assessment_start') }}"
               class="inline-flex items-center gap-2 rounded-lg border border-iron-600 px-5 py-2.5 font-semibold text-iron-100 hover:border-signal-500 hover:text-signal-500">
                {% include 'partials/_icon.html.twig' with { name: 'refresh', class: 'size-5' } %}
                {{ 'plan.regenerate'|trans }}
            </a>
        </div>

        {% if programme.coachingNotes is not empty %}
            <section class="mt-8 rounded-xl border border-iron-800 bg-iron-800/40 p-6">
                <h2 class="text-lg font-bold text-white">{{ 'plan.coaching_notes'|trans }}</h2>
                <p class="mt-3 leading-relaxed text-iron-200">{{ programme.coachingNotes }}</p>

                {#
                   Only when the prose layer actually ran. The claim is read off
                   the stored row rather than off whether an API key happens to
                   be set today, because it is a claim about this plan.
                #}
                {% if plan.llmUsed %}
                    <p class="mt-4 border-t border-iron-800 pt-4 text-xs leading-relaxed text-iron-400">
                        {{ 'plan.llm_note'|trans }}
                    </p>
                {% endif %}
            </section>
        {% endif %}

        <h2 class="mt-10 text-2xl font-bold text-white">{{ 'plan.weeks'|trans }}</h2>
        <p class="mt-2 text-sm text-iron-400">{{ 'plan.rir_help'|trans }}</p>

        <div class="mt-5 space-y-4">
            {% for week in plan.weeks %}
                {# The first week is open because it is the one being trained. #}
                <details class="rounded-xl border border-iron-800 bg-iron-800/40" {{ loop.first ? 'open' : '' }}>
                    <summary class="flex cursor-pointer flex-wrap items-center gap-3 px-6 py-4 text-lg font-bold text-white">
                        {{ 'plan.week'|trans({'%number%': week.index}) }}
                        {% if week.deload %}
                            <span class="rounded-full border border-signal-500/40 bg-signal-500/10 px-3 py-0.5 text-xs font-semibold uppercase tracking-wide text-signal-500">
                                {{ 'plan.deload'|trans }}
                            </span>
                        {% endif %}
                    </summary>

                    <div class="border-t border-iron-800 px-6 py-5">
                        {% if week.deload %}
                            <p class="mb-5 rounded-lg border border-signal-500/40 bg-signal-500/10 px-4 py-3 text-sm text-signal-500">
                                {{ 'plan.deload_note'|trans }}
                            </p>
                        {% endif %}

                        <div class="space-y-6">
                            {% for day in week.days %}
                                <div>
                                    <h3 class="text-sm font-semibold uppercase tracking-wide text-iron-400">
                                        {{ 'plan.day'|trans }} {{ day.index }} · <span class="text-iron-100">{{ day.label }}</span>
                                    </h3>

                                    <div class="mt-3 overflow-x-auto rounded-lg border border-iron-800">
                                        <table class="w-full min-w-[34rem] text-left text-sm">
                                            <caption class="sr-only">
                                                {{ 'plan.week'|trans({'%number%': week.index}) }} · {{ 'plan.day'|trans }} {{ day.index }} · {{ day.label }}
                                            </caption>
                                            <thead class="bg-iron-800/60 text-xs uppercase tracking-wide text-iron-400">
                                                <tr>
                                                    <th scope="col" class="px-4 py-2.5 font-semibold">{{ 'plan.exercise'|trans }}</th>
                                                    <th scope="col" class="px-4 py-2.5 font-semibold">{{ 'plan.sets'|trans }}</th>
                                                    <th scope="col" class="px-4 py-2.5 font-semibold">{{ 'plan.reps'|trans }}</th>
                                                    <th scope="col" class="px-4 py-2.5 font-semibold">{{ 'plan.rir'|trans }}</th>
                                                    <th scope="col" class="px-4 py-2.5 font-semibold">{{ 'plan.notes'|trans }}</th>
                                                </tr>
                                            </thead>
                                            <tbody class="divide-y divide-iron-800 text-iron-200">
                                                {% for exercise in day.exercises %}
                                                    <tr>
                                                        <th scope="row" class="px-4 py-2.5 text-left font-medium text-white">{{ exercise.name }}</th>
                                                        <td class="px-4 py-2.5">{{ exercise.sets }}</td>
                                                        <td class="px-4 py-2.5">{{ exercise.reps }}</td>
                                                        <td class="px-4 py-2.5">{{ exercise.rir is null ? '—' : exercise.rir }}</td>
                                                        <td class="px-4 py-2.5 text-iron-400">{{ exercise.notes }}</td>
                                                    </tr>
                                                {% endfor %}
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </details>
            {% endfor %}
        </div>

        <p class="mt-10 rounded-xl border border-signal-500/40 bg-signal-500/10 px-6 py-5 leading-relaxed text-signal-500">
            {{ 'plan.disclaimer'|trans }}
        </p>
    </section>
{% endblock %}
