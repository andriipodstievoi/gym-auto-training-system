{% extends 'base.html.twig' %}
{% import 'partials/_form_field.html.twig' as fields %}

{% block title %}{{ 'account.nav.profile'|trans }} · {{ 'brand.name'|trans }}{% endblock %}
{% block description %}{{ 'account.profile.lead'|trans }}{% endblock %}

{% block body %}
    <section class="mx-auto max-w-4xl px-4 py-14">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-signal-500">{{ 'account.kicker'|trans }}</p>
        <h1 class="mt-3 text-4xl font-black text-white">{{ 'account.nav.profile'|trans }}</h1>

        {% include 'account/_nav.html.twig' %}

        <div class="mt-8">
            {% include 'partials/_flashes.html.twig' %}
        </div>

        <div class="grid gap-8 md:grid-cols-2">
            <section class="rounded-xl border border-iron-800 bg-iron-800/40 p-7">
                <h2 class="text-xl font-bold text-white">{{ 'account.profile.title'|trans }}</h2>
                <p class="mt-2 text-sm text-iron-400">{{ 'account.profile.lead'|trans }}</p>

                {{ form_start(profileForm, { attr: { class: 'mt-6 space-y-5', novalidate: 'novalidate' } }) }}
                    {{ fields.field(profileForm.firstName) }}
                    {{ fields.field(profileForm.lastName) }}
                    {{ fields.field(profileForm.email) }}
                    {{ fields.field(profileForm.locale) }}

                    <button type="submit"
                            class="w-full rounded-lg bg-signal-500 px-4 py-2.5 font-semibold text-iron-900 hover:bg-signal-400">
                        {{ 'account.profile.submit'|trans }}
                    </button>
                {{ form_end(profileForm) }}
            </section>

            <section class="rounded-xl border border-iron-800 bg-iron-800/40 p-7">
                <h2 class="text-xl font-bold text-white">{{ 'account.password.title'|trans }}</h2>
                <p class="mt-2 text-sm text-iron-400">{{ 'account.password.lead'|trans }}</p>

                {{ form_start(passwordForm, { attr: { class: 'mt-6 space-y-5', novalidate: 'novalidate' } }) }}
                    {#
                       Password managers need to know which account these
                       passwords belong to. The field is deliberately outside
                       the form type's namespace, so it never reaches the form
                       as an extra field.
                    #}
                    <input type="text" name="username" autocomplete="username"
                           value="{{ app.user.email }}" hidden readonly tabindex="-1">

                    {{ fields.field(passwordForm.currentPassword) }}
                    {{ fields.field(passwordForm.newPassword.first) }}
                    {{ fields.field(passwordForm.newPassword.second) }}

                    <button type="submit"
                            class="w-full rounded-lg border border-iron-600 px-4 py-2.5 font-semibold text-white hover:border-signal-500 hover:text-signal-500">
                        {{ 'account.password.submit'|trans }}
                    </button>
                {{ form_end(passwordForm) }}
            </section>
        </div>
    </section>
{% endblock %}
