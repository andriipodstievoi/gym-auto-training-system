{% extends 'base.html.twig' %}

{% block title %}{{ 'account.plans.title'|trans }} · {{ 'brand.name'|trans }}{% endblock %}
{% block description %}{{ 'account.plans.lead'|trans }}{% endblock %}

{% block body %}
    <section class="mx-auto max-w-4xl px-4 py-14">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-signal-500">{{ 'account.kicker'|trans }}</p>
        <h1 class="mt-3 text-4xl font-black text-white">{{ 'account.plans.title'|trans }}</h1>

        {% include 'account/_nav.html.twig' %}

        <div class="mt-8">
            {% include 'partials/_flashes.html.twig' %}
        </div>

        <p class="text-iron-200">{{ 'account.plans.lead'|trans }}</p>

        {% if plans|length > 0 %}
            <div class="mt-6 overflow-x-auto rounded-xl border border-iron-800">
                <table class="w-full min-w-[38rem] text-left text-sm">
                    <caption class="sr-only">{{ 'account.plans.title'|trans }}</caption>
                    <thead class="bg-iron-800/60 text-xs uppercase tracking-wide text-iron-400">
                        <tr>
                            <th scope="col" class="px-5 py-3 font-semibold">{{ 'account.plans.generated'|trans }}</th>
                            <th scope="col" class="px-5 py-3 font-semibold">{{ 'account.plans.goal'|trans }}</th>
                            <th scope="col" class="px-5 py-3 font-semibold">{{ 'account.plans.split'|trans }}</th>
                            <th scope="col" class="px-5 py-3 font-semibold">
                                <span class="sr-only">{{ 'account.plans.view'|trans }}</span>
                            </th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-iron-800 text-iron-200">
                        {% for plan in plans %}
                            <tr>
                                <td class="px-5 py-3">
                                    {{ plan.createdAt|format_datetime('medium', 'short', timezone=gym_timezone()) }}
                                </td>
                                <td class="px-5 py-3">{{ plan.assessment.goal.translationKey|trans }}</td>
                                <td class="px-5 py-3 font-medium text-white">
                                    {#
                                       A referral has no split, because no engine
                                       ever ran. It is still listed: being told to
                                       see a doctor is an answer the member has to
                                       be able to find again.
                                    #}
                                    {{ plan.isReferral ? 'plan.referral.title'|trans : plan.split }}
                                </td>
                                <td class="px-5 py-3 text-right">
                                    <a href="{{ path('plan_show', {id: plan.id}) }}"
                                       class="rounded-lg border border-iron-700 px-3 py-1.5 font-medium text-iron-100 hover:border-signal-500 hover:text-signal-500">
                                        {{ 'account.plans.view'|trans }}
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <div class="mt-6 rounded-xl border border-iron-800 bg-iron-800/40 p-7">
                <p class="text-iron-200">{{ 'account.plans.empty'|trans }}</p>
                <a href="{{ path('assessment_start') }}"
                   class="mt-5 inline-block rounded-lg bg-signal-500 px-5 py-2.5 font-semibold text-iron-900 hover:bg-signal-400">
                    {{ 'account.plans.start'|trans }}
                </a>
            </div>
        {% endif %}
    </section>
{% endblock %}
