{% extends 'base.html.twig' %}

{% set locale = app.request.locale %}

{% block title %}{{ 'account.title'|trans }} · {{ 'brand.name'|trans }}{% endblock %}
{% block description %}{{ 'account.lead'|trans }}{% endblock %}

{% block body %}
    <section class="mx-auto max-w-4xl px-4 py-14">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-signal-500">{{ 'account.kicker'|trans }}</p>
        <h1 class="mt-3 text-4xl font-black text-white">{{ 'account.greeting'|trans({'%name%': app.user.firstName}) }}</h1>

        {% include 'account/_nav.html.twig' %}

        <div class="mt-8">
            {% include 'partials/_flashes.html.twig' %}
        </div>

        <h2 class="mt-4 text-xl font-bold text-white">{{ 'account.membership.title'|trans }}</h2>

        {% if current %}
            <article class="mt-4 rounded-xl border border-signal-500/40 bg-signal-500/5 p-7">
                <div class="flex flex-wrap items-start justify-between gap-4">
                    <div>
                        <h3 class="text-2xl font-bold text-white">{{ current.plan.name.get(locale) }}</h3>
                        <p class="mt-1 text-sm text-iron-300">
                            {{ current.plan.allBranches ? 'membership.all_branches'|trans : 'membership.single_branch'|trans }}
                        </p>
                    </div>
                    <span class="rounded-full bg-signal-500 px-3 py-1 text-xs font-bold uppercase tracking-wide text-iron-900">
                        {{ ('account.status.' ~ current.status.value)|trans }}
                    </span>
                </div>

                <dl class="mt-6 grid gap-5 sm:grid-cols-3">
                    <div>
                        <dt class="text-xs font-semibold uppercase tracking-wide text-iron-400">{{ 'account.membership.paid'|trans }}</dt>
                        <dd class="mt-1 text-lg font-bold text-white">{{ (current.pricePaidCents / 100)|format_currency('EUR') }}</dd>
                    </div>
                    {% if current.startsAt %}
                        <div>
                            <dt class="text-xs font-semibold uppercase tracking-wide text-iron-400">{{ 'account.membership.started'|trans }}</dt>
                            <dd class="mt-1 text-lg font-bold text-white">{{ current.startsAt|format_date('medium') }}</dd>
                        </div>
                    {% endif %}
                    {% if current.endsAt %}
                        <div>
                            <dt class="text-xs font-semibold uppercase tracking-wide text-iron-400">{{ 'account.membership.renews'|trans }}</dt>
                            <dd class="mt-1 text-lg font-bold text-white">{{ current.endsAt|format_date('medium') }}</dd>
                        </div>
                    {% endif %}
                </dl>

                {# A label and a number rather than a pluralised sentence: three
                   languages, three sets of plural rules, no upside. #}
                {% if current.endsAt %}
                    <p class="mt-5 text-sm text-iron-300">
                        {{ 'account.membership.days_left'|trans }}:
                        <strong class="text-white">{{ current.getDaysRemaining() }}</strong>
                    </p>
                {% endif %}
            </article>
        {% else %}
            <div class="mt-4 rounded-xl border border-iron-800 bg-iron-800/40 p-7">
                <p class="text-iron-200">{{ 'account.membership.none'|trans }}</p>
                <a href="{{ path('membership_index') }}"
                   class="mt-5 inline-block rounded-lg bg-signal-500 px-5 py-2.5 font-semibold text-iron-900 hover:bg-signal-400">
                    {{ 'account.membership.browse'|trans }}
                </a>
            </div>
        {% endif %}

        {% if history|length > 0 %}
            <h2 class="mt-12 text-xl font-bold text-white">{{ 'account.history.title'|trans }}</h2>
            <div class="mt-4 overflow-x-auto rounded-xl border border-iron-800">
                <table class="w-full min-w-[36rem] text-left text-sm">
                    <thead class="bg-iron-800/60 text-xs uppercase tracking-wide text-iron-400">
                        <tr>
                            <th scope="col" class="px-5 py-3 font-semibold">{{ 'account.history.plan'|trans }}</th>
                            <th scope="col" class="px-5 py-3 font-semibold">{{ 'account.history.bought'|trans }}</th>
                            <th scope="col" class="px-5 py-3 font-semibold">{{ 'account.history.price'|trans }}</th>
                            <th scope="col" class="px-5 py-3 font-semibold">{{ 'account.history.status'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-iron-800 text-iron-200">
                        {% for item in history %}
                            <tr>
                                <td class="px-5 py-3 font-medium text-white">{{ item.plan.name.get(locale) }}</td>
                                <td class="px-5 py-3">{{ item.createdAt|format_date('medium') }}</td>
                                <td class="px-5 py-3">{{ (item.pricePaidCents / 100)|format_currency('EUR') }}</td>
                                <td class="px-5 py-3">{{ ('account.status.' ~ item.status.value)|trans }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>
{% endblock %}
