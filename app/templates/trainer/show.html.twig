{% extends 'base.html.twig' %}

{% set locale = app.request.locale %}

{% block title %}{{ trainer.fullName }} · {{ 'brand.name'|trans }}{% endblock %}
{% block description %}{{ trainer.bio ? trainer.bio.get(locale) : 'trainer.index.lead'|trans }}{% endblock %}

{% block body %}
    <section class="mx-auto max-w-3xl px-4 pt-10 pb-16">
        <a href="{{ path('trainer_index') }}" class="text-sm font-medium text-iron-400 hover:text-signal-500">
            &larr; {{ 'trainer.show.back'|trans }}
        </a>

        <h1 class="mt-6 text-4xl font-black leading-tight text-white sm:text-5xl">{{ trainer.fullName }}</h1>

        <p class="mt-3 text-lg text-iron-200">
            {% if trainer.branch %}
                <a class="hover:text-signal-500" href="{{ path('branch_show', {slug: trainer.branch.slug}) }}">{{ trainer.branch.name }}</a>
            {% else %}
                {{ 'trainer.branch_unassigned'|trans }}
            {% endif %}
            &middot; {{ 'trainer.rate'|trans({'%amount%': (trainer.hourlyRateCents / 100)|format_currency('EUR')}) }}
        </p>

        <dl class="mt-6 space-y-3 text-sm">
            <div class="flex flex-wrap items-center gap-2">
                <dt class="uppercase tracking-wide text-iron-400">{{ 'trainer.specialities'|trans }}</dt>
                {% for speciality in trainer.specialityEnums %}
                    <dd class="rounded bg-iron-800 px-2.5 py-1 text-iron-200">{{ ('speciality.' ~ speciality.value)|trans }}</dd>
                {% endfor %}
            </div>
            <div class="flex flex-wrap items-center gap-2">
                <dt class="uppercase tracking-wide text-iron-400">{{ 'trainer.languages'|trans }}</dt>
                {% for language in trainer.languages %}
                    <dd class="rounded bg-iron-800 px-2.5 py-1 text-iron-200">{{ ('language.' ~ language)|trans }}</dd>
                {% endfor %}
            </div>
        </dl>

        {% if trainer.bio and not trainer.bio.isEmpty %}
            <h2 class="mt-10 text-lg font-bold text-white">{{ 'trainer.show.about'|trans }}</h2>
            <p class="mt-3 leading-relaxed text-iron-200">{{ trainer.bio.get(locale) }}</p>
        {% endif %}

        <div class="mt-10 rounded-xl border border-iron-800 bg-iron-800/40 p-6">
            {% if next_slots|length > 0 %}
                <h2 class="text-lg font-bold text-white">{{ 'trainer.next_slots'|trans }}</h2>
                <ul class="mt-4 flex flex-wrap gap-2">
                    {% for slot in next_slots %}
                        <li class="rounded-lg border border-iron-700 px-4 py-2 text-sm text-iron-100">
                            {{ slot.startsAt|format_datetime('medium', 'short', timezone=gym_timezone()) }}
                        </li>
                    {% endfor %}
                </ul>
            {% else %}
                <p class="text-sm text-iron-200">{{ 'trainer.no_availability'|trans }}</p>
            {% endif %}

            <div class="mt-6 flex flex-wrap gap-3">
                <a href="{{ path('trainer_booking_slots', {slug: trainer.slug}) }}"
                   class="rounded-lg bg-signal-500 px-5 py-2.5 font-semibold text-iron-900 hover:bg-signal-400">
                    {{ app.user ? 'trainer.book_cta'|trans : 'trainer.sign_in_to_book'|trans }}
                </a>

            </div>
        </div>

        {#
           Only for a signed-in member, and never for the coach whose own
           profile this is - a thread with yourself is not a thing. The first
           message opens the thread; there is no separate "start a
           conversation" screen to keep in step with the reply box.
        #}
        {% if can_message %}
            <form method="post" action="{{ path('message_send') }}" class="mt-6 rounded-xl border border-iron-800 bg-iron-800/40 p-6">
                <input type="hidden" name="_token" value="{{ csrf_token('message') }}">
                <input type="hidden" name="trainer" value="{{ trainer.slug }}">

                <h2 class="text-lg font-bold text-white">{{ 'trainer.message_cta'|trans }}</h2>

                <label for="coach-message" class="mt-4 block text-sm font-semibold text-white">
                    {{ 'message.body'|trans }}
                </label>
                <textarea id="coach-message" name="body" rows="3" required maxlength="2000"
                          placeholder="{{ 'message.placeholder'|trans }}"
                          class="mt-2 w-full rounded-lg border border-iron-700 bg-iron-900 px-4 py-3 text-iron-100 focus:border-signal-500 focus:outline-none"></textarea>

                <button type="submit"
                        class="mt-4 rounded-lg border border-iron-700 px-5 py-2.5 font-medium text-iron-100 hover:border-signal-500 hover:text-signal-500">
                    {{ 'message.send'|trans }}
                </button>
            </form>
        {% endif %}
    </section>
{% endblock %}
