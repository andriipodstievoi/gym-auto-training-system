{% extends 'base.html.twig' %}

{% set locale = app.request.locale %}

{% block title %}{{ 'trainer.index.title'|trans }} · {{ 'brand.name'|trans }}{% endblock %}
{% block description %}{{ 'trainer.index.lead'|trans }}{% endblock %}

{% block body %}
    <section class="mx-auto max-w-6xl px-4 pt-14 pb-8">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-signal-500">{{ 'trainer.index.kicker'|trans }}</p>
        <h1 class="mt-3 text-4xl font-black leading-tight text-white sm:text-5xl">{{ 'trainer.index.title'|trans }}</h1>
        <p class="mt-4 max-w-2xl text-lg text-iron-200">{{ 'trainer.index.lead'|trans }}</p>
    </section>

    <section class="mx-auto max-w-6xl px-4 pb-16">
        <div class="grid gap-5 md:grid-cols-2">
            {% for trainer in trainers %}
                <article class="flex flex-col rounded-xl border border-iron-800 bg-iron-800/40 p-6 transition hover:border-signal-600">
                    <div class="flex items-start justify-between gap-4">
                        <div>
                            {#
                               Deliberately a drawn mark rather than a portrait.
                               The fixtures describe people who do not exist, and
                               inventing photographs of them would be worse than
                               having none.
                            #}
                            <span class="mb-3 inline-flex rounded-lg bg-iron-900/60 p-2.5 text-signal-500">
                                {% include 'partials/_illustration.html.twig' with { name: 'trainer', class: 'size-7' } %}
                            </span>
                            <h2 class="text-xl font-bold text-white">{{ trainer.fullName }}</h2>
                            <p class="mt-1 text-sm text-iron-400">
                                {{ 'trainer.branch'|trans }}:
                                {{ trainer.branch ? trainer.branch.name : 'trainer.branch_unassigned'|trans }}
                            </p>
                        </div>
                        <p class="shrink-0 text-sm text-iron-200">
                            {{ 'trainer.rate'|trans({'%amount%': (trainer.hourlyRateCents / 100)|format_currency('EUR')}) }}
                        </p>
                    </div>

                    {% if trainer.bio and not trainer.bio.isEmpty %}
                        <p class="mt-4 text-sm leading-relaxed text-iron-200">{{ trainer.bio.get(locale) }}</p>
                    {% endif %}

                    <dl class="mt-5 space-y-2 text-xs">
                        <div class="flex flex-wrap items-center gap-2">
                            <dt class="uppercase tracking-wide text-iron-400">{{ 'trainer.specialities'|trans }}</dt>
                            {% for speciality in trainer.specialityEnums %}
                                <dd class="rounded bg-iron-800 px-2 py-1 text-iron-200">{{ ('speciality.' ~ speciality.value)|trans }}</dd>
                            {% endfor %}
                        </div>
                        <div class="flex flex-wrap items-center gap-2">
                            <dt class="uppercase tracking-wide text-iron-400">{{ 'trainer.languages'|trans }}</dt>
                            {% for language in trainer.languages %}
                                <dd class="rounded bg-iron-800 px-2 py-1 text-iron-200">{{ ('language.' ~ language)|trans }}</dd>
                            {% endfor %}
                        </div>
                    </dl>

                    <a href="{{ path('trainer_show', {slug: trainer.slug}) }}"
                       class="mt-auto pt-5 text-sm font-semibold text-signal-500 hover:text-signal-400">
                        {{ 'trainer.profile'|trans }} &rarr;
                    </a>
                </article>
            {% endfor %}
        </div>
    </section>
{% endblock %}
