# Production environment for infra/compose.prod.yaml.
#
# Copy this file to infra/deploy/.env.prod on the server and fill it in.
# .env.prod is git-ignored and is the only place real values exist:
#
#     cp infra/deploy/.env.prod.example infra/deploy/.env.prod
#
# Compose reads it with env_file:, so every line here becomes a real
# environment variable inside the containers, which beats anything committed
# in app/.env or app/.env.prod. No quoting rules and no shell expansion: the
# value is everything after the first "=", verbatim, so do not wrap values in
# quotes unless the quotes are part of the value.
#
# Nothing in this example is a real credential and nothing here should ever
# become one. Do not commit .env.prod, and do not paste real values into this
# file by mistake.


# --- Site identity -----------------------------------------------------------

# The hostname Caddy answers on and gets a certificate for. It must already
# resolve to this VM's public IP before the first request, or the ACME
# challenge fails. One name, no scheme, no trailing slash.
#
# For a local smoke test, "localhost" makes Caddy use its own internal CA and
# never contact Let's Encrypt at all.
SITE_DOMAIN=speks.example.com

# Where Let's Encrypt sends certificate expiry warnings. Required: Caddy's
# "email" option takes an argument, so an empty value here is a Caddyfile parse
# error and Caddy restarts in a loop instead of serving. Any mailbox somebody
# reads will do.
ACME_EMAIL=you@example.com

# The origin Symfony uses when it has no request to work from: CLI commands,
# and every link inside an email. Must match SITE_DOMAIN and must include the
# scheme.
DEFAULT_URI=https://speks.example.com


# --- Application -------------------------------------------------------------

# Symfony's secret. Used to sign the "remember me" cookie and the CSRF and
# URI signer hashes, so changing it invalidates every one of them.
#
# The value in app/.env has been in a public repository since M3 and must be
# treated as public knowledge. Generate a fresh one and put it here only:
#
#     php -r 'echo bin2hex(random_bytes(16)), "\n";'
#
# or, without PHP on the box:
#
#     openssl rand -hex 16
APP_SECRET=

# Reverse-proxy trust. infra/compose.prod.yaml sets TRUSTED_PROXIES on the php
# service itself, because it follows from the topology rather than from the
# deployment, and nothing here should override it.


# --- Database ----------------------------------------------------------------
#
# MYSQL_* initialise the MySQL container the first time it starts, on an empty
# db_data volume. Changing them afterwards does nothing: MySQL only reads them
# during initialisation. To change the password later, do it in SQL and update
# DATABASE_URL to match.
#
# DATABASE_URL is what Symfony connects with, and it has to agree with the
# three values above - same user, same password, same database. The host is
# the compose service name and the port is the container's own 3306; neither
# is published outside the stack. serverVersion must stay in step with the
# mysql image tag in infra/compose.prod.yaml.
#
# infra/deploy/provision.sh writes all four from one generated password, which
# is the way to avoid them drifting apart.

MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=gym_app
MYSQL_USER=gym
MYSQL_PASSWORD=
DATABASE_URL=mysql://gym:CHANGE_ME@mysql:3306/gym_app?serverVersion=8.4.3-mysql&charset=utf8mb4


# --- Mail --------------------------------------------------------------------

# No mail provider is a supported state. null://null accepts every message and
# delivers none, so account and booking mail silently goes nowhere and nothing
# raises. app/.env.prod already defaults to it; this line is here so the value
# is visible in the file somebody actually edits.
#
# For real outbound mail, docs/HOSTING.md suggests Brevo's free relay:
#
#     MAILER_DSN=smtp://USER:PASSWORD@smtp-relay.brevo.com:587
MAILER_DSN=null://null


# --- Optional integrations ---------------------------------------------------
#
# All four are deliberately empty, and empty is a supported state rather than a
# broken one. With no Stripe keys the membership and checkout pages say
# checkout is unavailable instead of rendering a dead button; with no Anthropic
# key the plan generator still produces a complete plan from the rule engine
# and simply skips the coaching prose. Both paths are tested. Fill them in when
# there is an account behind them, and not before.

# Stripe, test mode. From the Stripe dashboard.
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
# From "stripe listen" or from the endpoint's signing secret in the dashboard.
# Without it the webhook rejects every call, and only the webhook may mark a
# membership active or an order paid.
STRIPE_WEBHOOK_SECRET=

# Anthropic key for the prose layer in ai-service. Read by pydantic-settings
# as the "anthropic_api_key" setting via its AI_ prefix.
AI_ANTHROPIC_API_KEY=


# --- Host ports --------------------------------------------------------------
#
# Read by compose interpolation rather than by the containers, which means they
# only take effect when this file is also passed as --env-file. Production
# wants the defaults, 80 and 443; the local smoke test in docs/DEPLOY.md moves
# them so the dev stack can keep running.
#
# HTTP_PORT=80
# HTTPS_PORT=443
